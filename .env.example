# WNBA Predictions — environment variables
# Copy to .env and fill in the keys you have.

# Odds-API.io (https://odds-api.io) — primary WNBA moneylines/spreads/totals
ODDS_API_IO_KEY=

# TheRundown (https://therundown.io) — secondary WNBA moneylines/spreads/totals
THERUNDOWN_API_KEY=

# Legacy provider, retained only for explicit/manual fallback use
ODDS_API_KEY=

# Optional provider controls
# ODDS_API_IO_BOOKMAKERS=DraftKings,Bet365
# ODDS_API_IO_LEAGUE=
# ODDS_API_IO_MAX_REQUESTS=20
# THERUNDOWN_AFFILIATE_IDS=19,23
# THERUNDOWN_MARKET_IDS=1,2,3
# THERUNDOWN_LOOKAHEAD_DAYS=7
# THERUNDOWN_MAX_REQUESTS=10

# BALLDONTLIE API key (optional; WNBA coverage limited)
BALLDONTLIE_API_KEY=
